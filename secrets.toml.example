# =====================================================================
# TEMPLATE de credenciais do dashboard
#
# COMO USAR:
#   1. Copie este arquivo para  .streamlit/secrets.toml
#   2. Preencha os valores marcados com <...>
#   3. NUNCA comite .streamlit/secrets.toml (ja esta no .gitignore)
#
#   Este arquivo (.example) pode ser comitado — ele nao tem segredo
#   nenhum, so serve de modelo.
# =====================================================================


# ---------------------------------------------------------------------
# RDS PostgreSQL — dados (tabelas simulations, phase_transition,
#                         ant_trajectories)
# ---------------------------------------------------------------------
# Formato: postgresql://USUARIO:SENHA@ENDPOINT:5432/NOME_DO_BANCO
#
# O endpoint aparece no console AWS em RDS > Databases > ants-db >
# "Endpoint & port". O nome do banco nao tem hifen.
#
# Se voce DEIXAR esta linha comentada/ausente, o app roda em modo
# LOCAL: le os CSVs da pasta data/ em vez do RDS. Util para testar.

DATABASE_URL = "postgresql://Leoadmin:<SUA_SENHA>@ants-db.cwhu4kee48z8.us-east-1.rds.amazonaws.com:5432/antsactivematter2026"


# ---------------------------------------------------------------------
# S3 — modelos de rede neural (abas "Formiga Individual" e
#                              "Validacao do Modelo")
# ---------------------------------------------------------------------
# Sem estas 3 linhas, essas duas abas ficam desabilitadas com um aviso;
# o resto do dashboard funciona normalmente.
#
# Alternativa sem AWS: coloque os 9 arquivos de modelo numa pasta
# models/ ao lado do app.py — o app usa a pasta local primeiro e so
# recorre ao S3 se faltar algum arquivo.

S3_BUCKET = "ants-active-matter-2026"
AWS_ACCESS_KEY_ID = "<SUA_ACCESS_KEY>"
AWS_SECRET_ACCESS_KEY = "<SUA_SECRET_KEY>"


# ---------------------------------------------------------------------
# Opcional — caminhos das pastas locais
# ---------------------------------------------------------------------
# Descomente para apontar para outro lugar (default: data/ e models/,
# ao lado do app.py).

# LOCAL_DATA_DIR = "data"
# LOCAL_MODELS_DIR = "models"
